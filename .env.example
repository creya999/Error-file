USE_SQLITE=false

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=adbn_instant_card
DB_USER=sa
DB_PASSWORD=YourSQLServerPasswordHere

# Generate a strong random key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=adbn-change-this-to-a-random-secret-key

# Production server settings (optional — defaults shown)
APP_HOST=127.0.0.1
APP_PORT=5000
APP_THREADS=4
